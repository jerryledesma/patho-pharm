{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patho-pharm/lecture.schema.json",
  "title": "Study Notebook lecture",
  "description": "public/lectures/<id>/lecture.json. Enforced by scripts/validate.mjs (which also checks answer keys, ID uniqueness, the ID ledger and companion files notes.html + map.svg).",
  "type": "object",
  "required": ["id", "date", "title", "instructor", "course", "tiers", "practice", "clinical", "cards", "qa"],
  "additionalProperties": false,
  "$defs": {
    "src": { "type": "string", "description": "Where the item came from: 'slide 12', '00:41:10', 'supp-01 p2'. Hidden from the learner; used for review." },
    "letters": { "type": "string", "pattern": "^[A-F](, ?[A-F])*$" },
    "options": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string", "minLength": 1 } }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(-[a-z0-9]+){0,2}$", "description": "Class date + 1-3 word topic slug. Permanent once published." },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 45 },
    "instructor": { "type": "string", "minLength": 1, "description": "First Last, CREDENTIALS" },
    "course": { "type": "string" },
    "sources": {
      "type": "array",
      "description": "Files this lecture was built from (names per the naming convention).",
      "items": { "type": "string" }
    },
    "tiers": {
      "type": "object",
      "description": "Practice tier labels, e.g. {\"1\":\"recall\",\"2\":\"application\",\"3\":\"ABG interpretation\"}",
      "propertyNames": { "enum": ["1", "2", "3"] },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "practice": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "tier", "type", "stem", "options", "answer", "rationale"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^p-\\d{3}$" },
          "tier": { "enum": ["1", "2", "3"] },
          "type": { "enum": ["mc", "sata", "order"] },
          "stem": { "type": "string" },
          "options": { "$ref": "#/$defs/options" },
          "answer": { "$ref": "#/$defs/letters" },
          "rationale": { "type": "string" },
          "src": { "$ref": "#/$defs/src" }
        }
      }
    },
    "clinical": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "setting", "text", "questions"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^c\\d{2}$" },
          "title": { "type": "string" },
          "setting": { "type": "string" },
          "text": { "type": "string", "description": "HTML allowed; newlines render as line breaks." },
          "questions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "type", "stem", "options", "answer", "rationale"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^c\\d{2}-q\\d{2}$" },
                "type": { "enum": ["mc", "sata", "order"] },
                "stem": { "type": "string" },
                "options": { "$ref": "#/$defs/options" },
                "answer": { "$ref": "#/$defs/letters" },
                "rationale": { "type": "string" },
                "src": { "$ref": "#/$defs/src" },
                "step": { "enum": ["recognize", "analyze", "prioritize", "generate", "act", "evaluate"], "description": "NGN clinical-judgment step this question measures (shown as a label)." }
              }
            }
          }
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "front", "back", "tag"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^fc-\\d{3}$" },
          "front": { "type": "string" },
          "back": { "type": "string" },
          "tag": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "src": { "$ref": "#/$defs/src" }
        }
      }
    },
    "qa": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "q", "a"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^qa-\\d{3}$" },
          "q": { "type": "string" },
          "a": { "type": "string" },
          "src": { "$ref": "#/$defs/src" }
        }
      }
    }
  }
}
